# Docker 部署配置
IMAGE_NAME=practice-gk
IMAGE_TAG=latest

# 宿主机发布端口（仅绑定 127.0.0.1，供宿主机反代使用；按需改，如 12001）
GK_HOST_PORT=8080
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# 资源限制
GOMAXPROCS=2
GOMEMLIMIT=768MiB

# 域名配置（必填：用于生成 --public-origin，缺失会直接报错）
DOMAIN=practice.example.com

# 容器路线可信代理网段。容器内看到的 RemoteAddr 是 Docker 网关，
# 不信任该网段会让所有访客共用一个限速桶（安全审计 H-2）。
# 默认 Docker 桥接网段 172.16.0.0/12；若改成自定义 IPAM 网段，请同步修改。
# 不要在这里填 0.0.0.0/0：那等于信任任何客户端伪造的 X-Forwarded-For。
GK_TRUSTED_PROXIES=172.16.0.0/12
