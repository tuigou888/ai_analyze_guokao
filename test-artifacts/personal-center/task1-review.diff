+	r.Header.Set("Content-Type", "application/json")
+	r.Header.Set("X-Forwarded-For", "2001:db8:abcd:1234::42, 10.0.0.3")
+	r.Header.Set("User-Agent", "Mozilla/5.0 (iPhone) CriOS/123.0 Safari/537.36")
+	w := httptest.NewRecorder()
