+<template><section class="pc-card pc-chart" data-chart="trend"><h2>作答趋势</h2><p class="muted small">每天提交的非空作答。次数与正确率分别使用独立坐标。</p><label class="pc-chart-select">查看日期<select v-model.number="selected"><option v-for="(day,i) in items" :key="day.date" :value="i">{{ day.date }}</option></select></label><div class="pc-trend-plot" tabindex="0" role="group" aria-label="每日作答趋势，左右键选择日期" @keydown="move"><p class="pc-chart-unit">作答次数（次）</p><svg viewBox="0 0 580 156" role="img" aria-label="每日作答次数柱状图"><template v-for="tick in [0,max/2,max]" :key="tick"><line x1="36" x2="570" :y1="y(tick,max)" :y2="y(tick,max)" class="pc-grid-line"/><text x="29" :y="y(tick,max)+4" text-anchor="end">{{ Math.round(tick) }}</text></template><g v-for="(day,i) in items" :key="day.date" @mouseenter="selected=i" @click="selected=i"><rect :x="x(i)-250/items.length" :y="y(day.answered,max)" :width="Math.max(2,500/items.length)" :height="Math.max(1,day.answered/max*104)" :class="['pc-bar',{'pc-bar-selected':i===selected}]"/><rect :x="x(i)-265/items.length" y="20" :width="530/items.length" height="116" fill="transparent"><title>{{ day.date }}：{{ day.answered }} 次</title></rect></g><text x="36" y="153">{{ items[0]?.date?.slice(5) }}</text><text x="568" y="153" text-anchor="end">{{ items.at(-1)?.date?.slice(5) }}</text></svg><p class="pc-chart-unit">正确率（%）· 无作答日留空</p><svg viewBox="0 0 580 156" role="img" aria-label="每日正确率点图，无作答日留空"><template v-for="tick in [0,50,100]" :key="tick"><line x1="36" x2="570" :y1="y(tick,100)" :y2="y(tick,100)" class="pc-grid-line"/><text x="29" :y="y(tick,100)+4" text-anchor="end">{{ tick }}</text></template><g v-for="(day,i) in items" :key="day.date" @mouseenter="selected=i" @click="selected=i"><line v-if="i>0&&day.accuracy!=null&&items[i-1].accuracy!=null" :x1="x(i-1)" :y1="y(items[i-1].accuracy,100)" :x2="x(i)" :y2="y(day.accuracy,100)" class="pc-line"/><circle v-if="day.accuracy!=null" :cx="x(i)" :cy="y(day.accuracy,100)" :r="i===selected?5:3" class="pc-point"/><rect :x="x(i)-265