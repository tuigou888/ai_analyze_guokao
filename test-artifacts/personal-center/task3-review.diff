 import { reactive } from 'vue'
-export const auth = reactive({ user: null, admin: null })
+import { api } from './api'
+export const auth = reactive({ user: null, admin: null, profile: null })
+// Only the currently verified user owns this in-memory preference cache.
+let profileGeneration = 0
+let profileUserID = null
+export function clearUser() {
+  profileGeneration++
+  auth.user = null
+  auth.profile = null
+  profileUserID = null
+}
+export function setUser(user) {
+  if (profileUserID !== user?.id) { profileGeneration++; auth.profile = null; profileUserID = null }
+  auth.user = user
+}
+export function applyProfile(profile, userID = auth.user?.id) {
+  if (!auth.user || userID !== auth.user.id || profile.username !== auth.user.username) return false
+  profileUserID = auth.user?.id ?? null
+  auth.profile = profile
+  if (auth.user) auth.user.nickname = profile.nickname
+  return true
+}
+export async function loadProfile() {
+  const id = auth.user?.id, generation = ++profileGeneration
+  if (id == null) return null
+  const profile = await api.profile()
+  if (generation === profileGeneration && auth.user?.id === id) applyProfile(profile)
+  return generation === profileGeneration && auth.user?.id === id ? profile : null
+}
