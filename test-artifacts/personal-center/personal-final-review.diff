+			if w.Code != 400 {
+				t.Fatalf("missing/null %s null=%t: %d %s", key, null, w.Code, w.Body.String())
+			}
+		}
+	}
+	w, _ := requestTest(t, h, "PUT", "/api/account/profile", profileBody(t, map[string]any{"Avatar_ID": 0}), cookie)
+	if w.Code != 400 {
