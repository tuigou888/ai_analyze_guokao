ass="pc-session-pagination" aria-label="登录会话分页"><button :disabled="sessionsBusy||sessions.page<=1" @click="load(sessions.page-1)">上一页</button><span>第 {{ sessions.page }} 页 · {{ sessions.total }} 个会话</span><button :disabled="sessionsBusy||sessions.page*20>=sessions.total" @click="load(sessions.page+1)">下一页</button></nav></section></div></template>
